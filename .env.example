HOST=127.0.0.1
PORT=8787
DATA_DIR=./var
UPSTREAM_TIMEOUT_MS=20000
# Shared grid acquisition at 08:00/16:00; public reads spend zero units.
DAILY_WEATHER_BUDGET=10000
# Optional: Open-Meteo paid access. Empty uses the public personal-use tier.
OPEN_METEO_API_KEY=
# Private server key for manual refresh. Empty disables manual refresh.
SUNSETBOT_REFRESH_KEY=
# Optional Docker runtime proxy. On macOS, host.docker.internal reaches the host.
# SUNSETBOT_HTTP_PROXY=http://host.docker.internal:7890
